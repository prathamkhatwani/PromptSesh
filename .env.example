# Database
DATABASE_URL="postgresql://user:password@localhost:5432/promptcode?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"
AUTH_SECRET="your-auth-secret-here"

# GitHub OAuth
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# LLM API Keys (Free Models: meta-llama/llama-3.3-70b-instruct:free & google/gemini-2.0-flash-exp:free)
OPENROUTER_API_KEY="your-openrouter-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Rate Limiting
MAX_SUBMISSIONS_PER_HOUR=10
MAX_TOKENS_PER_SUBMISSION=4096
