# Database
DATABASE_URL="postgresql://user:password@localhost:5432/promptsesh?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"
AUTH_SECRET="your-auth-secret-here"

# GitHub OAuth
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# LLM API Keys (Free Models: meta-llama/llama-3.3-70b-instruct:free & google/gemini-2.0-flash-exp:free)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# LLM Mock Mode (set to "true" to use local sandbox evaluations without API keys)
LLM_MOCK_MODE="false"

# Email Configuration (for Password Reset & Verification)
# Option A: Resend API (Recommended)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="PromptSesh <security@promptsesh.com>"

# Option B: Custom SMTP (Gmail, Brevo, SendGrid, Amazon SES)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="PromptSesh <your-email@gmail.com>"

# Observability & Error Tracking (Sentry)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

